// Пояснения ко всем настройкам плагина. Файл справочный: рядом с DLL кладётся
// bridge.settings.json — тот же набор, но без комментариев (JSON их не умеет).
//
// Здесь описано ровно то, что читает код: BridgeConfig.cs для Reservly и
// MamaRomaConfig.cs для приложения. Настроек, которых нет в этом файле,
// плагин не знает — лишние ключи он молча игнорирует.
//
// Ключи регистронезависимы. Значения ниже — те, что стоят сейчас в бою.
{
  // ═══════════════════════════════════════════════════════════════
  //  RESERVLY — сбор данных ресторана
  //
  //  Плагин раз в pollIntervalSeconds собирает данные и отправляет их
  //  одним пакетом. Если данные не изменились с прошлого раза, пакет
  //  не уходит: каждое событие сверяется по хэшу.
  // ═══════════════════════════════════════════════════════════════

  // Куда отправлять. Номер в адресе — профиль ресторана в Reservly,
  // у каждой точки он свой. Берётся из карточки профиля в админке Reservly.
  "backendUrl": "https://reservly.ru/api/iiko/front/profiles/3/ingest/",

  // Ключ этого профиля, уходит заголовком X-IikoFront-Secret.
  // В адресе секрет не передаётся намеренно: URL попадают в логи прокси.
  // Смена ключа в админке Reservly: старый принимается ещё сутки.
  "secret": "74f49ba0fc2f8df45a6b070d8edab6ee40acc76b18f33b0126bbb0fd1440fc4c",

  // Имя этой установки. Сервер запоминает его при первом запросе и дальше
  // принимает данные только с ним: подменили терминал — данные не примут.
  // Пусто — плагин подставит отпечаток организации.
  "installationId": "89786",

  // Главный выключатель всего старого контура Reservly.
  // true  — всё работает как раньше: таймер, очередь, события, стоп-лист.
  // false — плагин вообще не запускает отправку в Reservly. На секцию
  //         mamaroma это не влияет: у неё свой enabled и свой таймер.
  "reservlyEnabled": true,

  // Что писать в logs/reservly-bridge.log рядом с DLL.
  //   off   — ничего
  //   error — только ошибки
  //   warn  — ошибки и предупреждения (так держим в бою)
  //   info  — подробно, каждый шаг. Для разбора проблемы, не для постоянной работы:
  //           файл растёт быстро.
  "diagnosticsLogLevel": "warn",

  // Главный цикл: раз в столько секунд собираем и отправляем. Меньше 30 нельзя —
  // ограничение в коде, чтобы не грузить терминал.
  "pollIntervalSeconds": 30,

  // Отдельный сигнал «я жив», чтобы Reservly отличал «данных нет»
  // от «терминал выключен». Раз в 15 минут.
  "pingIntervalSeconds": 900,

  // ── Что собирать. Каждый флаг выключает свой кусок целиком ────────

  // Список сотрудников с их ролями. Нужен, чтобы явки и выручка
  // связывались с конкретными людьми, а не с безымянными кодами.
  "syncEmployees": true,

  // Явка по сессиям: кто когда залогинился на терминале и вышел.
  // Основной источник рабочего времени.
  "syncAttendance": true,

  // Закрытая выручка по прошлым заказам. Считается по бизнес-дню,
  // а не по календарным суткам — см. businessDayEndHour.
  "syncRevenue": true,

  // Доставки: заказы и дневные показатели по ним.
  "syncDeliveries": true,

  // Сырые отчёты фронта (035 Явки, продажи, доставки) как есть.
  // Тяжёлый и медленный путь, для нынешнего контура запасной — обычно выключен.
  "syncReportSnapshots": true,

  // Открытые заказы столов. По ним бронь Reservly связывается с реальным
  // заказом: гость сел, заказал, ушёл.
  "syncTableOrders": true,

  // Оперативный снимок для раздела «Живая выручка»: открытые столы,
  // предчеки, закрытые заказы, доставки, выручка по официантам и блюдам.
  "syncLiveRevenue": true,

  // Текущий стоп-лист фронта. Reservly сам ведёт историю: когда позиция
  // появилась в стопе и когда исчезла — Front отдаёт только срез «сейчас».
  "syncStopList": true,

  // Диагностика самого плагина: версия, глубина офлайн-очереди, время
  // последней успешной отправки, какие флаги включены. По ней видно,
  // что происходит на терминале, не заходя на него.
  "syncBridgeStatus": true,

  // Кассовая смена: открытие, закрытие, внесения и изъятия.
  "syncCashSession": true,

  // Пакет не ушёл из-за связи или ошибки сервера (таймаут, 429, 5xx) —
  // кладём его на диск рядом с DLL и досылаем, когда связь вернётся.
  // Выключать не стоит: в ресторане интернет пропадает регулярно.
  "offlineQueueEnabled": true,

  // Жизненный цикл заказа: открыт, предчек, закрыт, суммы, официант, блюда.
  "syncOrderLifecycle": true,

  // Подробный аудит: скидки, удаления блюд, сторно, возвраты,
  // нефискальные и «без выручки» оплаты. То, что смотрят при разборе смены.
  "syncOrderAudit": true,

  // Ежедневная сверка контрольных сумм по закрытым заказам: сходится ли
  // то, что видит Reservly, с тем, что закрыла касса.
  "syncDailyReconciliation": true,

  // ── Как считать деньги ───────────────────────────────────────────

  // Исключать представительские, служебные и «без выручки» оплаты
  // из операционной выручки. Тип оплаты определяется по его признакам в iiko.
  "excludeNonRevenuePayments": true,

  // Типы оплат, которые в iiko заведены как безналичные или кредитные,
  // но по факту это живые деньги в кассе. Пишутся ТОЧНО как в справочнике iiko.
  // Пример: расчёт от турфирмы, который кассир проводит отдельным типом.
  "treatAsCashPaymentTypes": [
    "Невский тур"
  ],

  // Типы оплат, за которыми реальных денег нет: внутренние счета,
  // расчёты с вкладчиками, списания на своих. В выручку не попадают.
  // Тоже точное название из справочника iiko.
  "treatAsNonRevenuePaymentTypes": [
    "Вкладчики"
  ],

  // ── Как часто отправлять каждый кусок ────────────────────────────
  //
  //  Плагин просыпается каждые pollIntervalSeconds, но не шлёт всё подряд:
  //  у каждого события свой интервал. Живая выручка нужна почти в реальном
  //  времени, сотрудники — раз в сутки.

  // Живая выручка: раз в минуту, даже если снимок почти не изменился.
  "liveRevenueSyncIntervalMinutes": 1,

  // Стоп-лист.
  "stopListSyncIntervalMinutes": 5,

  // Статус самого плагина.
  "bridgeStatusSyncIntervalMinutes": 5,

  // Жизненный цикл заказов.
  "orderLifecycleSyncIntervalMinutes": 2,

  // Аудит заказов.
  "orderAuditSyncIntervalMinutes": 5,

  // Сверка дня.
  "dailyReconciliationSyncIntervalMinutes": 30,

  // Сотрудники: при изменениях уходят сразу, а так — не чаще раза в сутки.
  "employeesSyncIntervalMinutes": 1440,

  // ── Явка и глубина просмотра ─────────────────────────────────────

  // Сессия короче этого — не явка, а случайный вход на терминал.
  // Такие записи не отправляем.
  "minAttendanceMinutesToSend": 15,

  // Сколько дней держать в локальном агрегате явки рядом с DLL.
  // Файл переживает перезапуск плагина, поэтому смена не теряется.
  "attendanceLookbackDays": 3,

  // На сколько дней назад смотреть прошлые заказы для выручки и доставок.
  // Двух хватает: бизнес-день закрывается в 06:00, и вчерашняя ночь
  // должна попасть в счёт. Это не исторический перенос данных.
  "pastOrdersLookbackDays": 2,

  // Час, до которого заказ относится к предыдущему бизнес-дню.
  // Заказ, закрытый в 04:30, — это вчерашняя выручка, а не сегодняшняя.
  "businessDayEndHour": 6,

  // ── Отчёты фронта ────────────────────────────────────────────────
  //
  //  Работают, только когда включён syncReportSnapshots. Снимаются редко:
  //  фронт строит их долго и на это время подтормаживает.

  "attendanceReportSyncIntervalMinutes": 30,
  "revenueReportSyncIntervalMinutes": 30,
  "deliveryReportSyncIntervalMinutes": 30,

  // Как часто проверять лицензию модуля iikoFront. Истекла — Reservly
  // узнает об этом раньше, чем плагин перестанет работать.
  "licenseStatusSyncIntervalMinutes": 15,

  // Внутренние коды отчётов iiko. Менять только если в вашей версии
  // они называются иначе — иначе снимок вернётся пустым.
  "attendanceReportId": "EMPLOYEES_ATTENDANCES_REPORT",
  "revenueReportId": "SALES_BY_TYPE_WITH_TAX_SESSION_REPORT",
  "deliveryReportId": "DELIVERY_REPORT",

  // PIN сотрудника, под которым плагин откроет сессию, чтобы снять отчёт,
  // когда на терминале никто не залогинен (ночью, между сменами).
  // Пусто — отчёты в такие моменты просто не снимаются.
  "reportSessionPin": "",

  // ─────────────────────────────────────────────────────────────
  //  ПРИЛОЖЕНИЕ MAMA ROMA
  //
  //  Второй, независимый контур. У него свой таймер, свой клиент и свой
  //  секрет — настройки ниже никак не влияют на отправку в Reservly выше.
  //  enabled: false — ни одна строчка этого кода не исполняется,
  //  плагин ведёт себя ровно как раньше.
  // ─────────────────────────────────────────────────────────────
  "mamaroma": {
    // Главный выключатель всего блока.
    "enabled": false,

    // Корень ручек приложения — БЕЗ слэша на конце.
    //   прод:     https://restourant-bot.ru/mamaroma/api/v1/integrations/iiko
    //   локально: http://192.168.0.2:8000/api/v1/integrations/iiko
    // Адрес прода взят из apps/mobile/eas.json, профиль preview.
    "backendUrl": "https://restourant-bot.ru/mamaroma/api/v1/integrations/iiko",

    // Секрет ЭТОЙ точки. У каждого ресторана свой: утёк один терминал —
    // меняем ключ только ему. Лежит в таблице iiko_bridges.secret.
    // Уходит заголовком X-Iiko-Bridge-Secret.
    "secret": "",

    // UUID ресторана из таблицы restaurants базы приложения.
    // Именно этим плагин привязан к конкретной точке: сервер по нему
    // понимает, чей стоп-лист приехал и чьи заказы отдавать.
    // На каждом терминале — СВОЙ.
    "restaurantId": "",

    // ── Заказы: приложение → касса ──────────────────────────────

    // Забирать заказы с сервера и заводить их в iikoFront.
    // Единственное место, где плагин ПИШЕТ в iiko, а не читает.
    // На обкатке держать false: тогда работает только чтение.
    "acceptDeliveries": true,

    // Как часто спрашивать сервер про новые заказы. Гость ждёт,
    // поэтому чаще, чем остальное. Меньше 10 секунд смысла нет.
    "deliveryPollIntervalSeconds": 20,

    // Код типа заказа для доставки курьером. Самый надёжный способ:
    // список типов заказов iikoFront через API вообще не отдаёт.
    // Плагин при старте пишет в лог типы, встреченные в уже заведённых
    // доставках, — оттуда и берётся код.
    "deliveryOrderTypeId": "",

    // То же для самовывоза.
    "pickupOrderTypeId": "",

    // Код источника заказа: в отчётах iiko заказы приложения отделятся
    // от сайта и колл-центра. Пусто — источник не проставляем.
    "marketingSourceId": "",

    // Название типа заказа — запасной способ, если код не задан. Ищется
    // среди типов, встреченных в уже заведённых доставках этой точки.
    // Ничего не нашлось — берём первый тип с нужным способом обслуживания.
    "deliveryOrderTypeName": "",

    // То же для самовывоза.
    "pickupOrderTypeName": "",

    // Платные приборы: в приложении это отдельная строка счёта, поэтому
    // в iiko они тоже добавляются отдельным товаром, а не только комментарием.
    // productId берём из номенклатуры iiko этой точки.
    "cutleryProductId": "",
    "cutleryProductSizeId": "",
    "cutleryProductName": "Приборы",

    // Аварийный товар для случаев, когда наше блюдо или добавка не нашли
    // свой productId в iiko. Пусто — заказ не создаётся и вернётся ошибкой.
    // Заполнено — вместо проблемной позиции добавится этот товар с ценой 0,
    // кастомным именем «НЕ НАЙДЕНО: ...» и комментарием к позиции.
    // На Большевиков сейчас подходит товар «Стакан одноразовый» из группы
    // «ТАРА для доставки».
    "missingProductFallbackProductId": "",
    "missingProductFallbackProductSizeId": "",
    "missingProductFallbackProductName": "Аварийная позиция",

    // Сколько минут закладывать на доставку, если сервер не прислал своё.
    // Используется и как запас: заказ «на сейчас» iiko отвергнет как
    // слишком ранний, поэтому ставим текущее время плюс это число.
    "defaultDeliveryMinutes": 60,

    // Сколько заказов забирать за один заход. Ограничение на случай,
    // если связь пропадала надолго и очередь накопилась.
    "deliveryBatchSize": 10,

    // ── Стоп-лист: касса → приложение ───────────────────────────

    // Отдавать приложению, что сейчас нельзя продавать.
    "syncStopList": true,

    // Как часто сверять. Раз в минуту — гость не успеет положить
    // в корзину то, чего уже нет.
    "stopListIntervalMinutes": 1,

    // ВАЖНО. В iiko «поставить в стоп-лист» и «выставить остаток» —
    // РАЗНЫЕ действия, и продажу запрещает только первое.
    // Повар может выставить остаток «0» и думать, что закрыл блюдо,
    // а касса его спокойно пробьёт.
    //
    // true  — прячем и по остатку тоже, не только по формальному стопу
    // false — верим только формальному стоп-листу
    "stopOnRemainingAmount": true,

    // Порог остатка. Работает, только если stopOnRemainingAmount = true.
    // Прячем блюдо, когда порций осталось МЕНЬШЕ ИЛИ РОВНО столько.
    //   0 — только когда не осталось совсем
    //   5 — прячем заранее: последние 5 порций уйдут в зал,
    //       а не в доставку, где гость их ждёт полчаса
    "remainingAmountThreshold": 0,

    // ── Номенклатура: касса → приложение ────────────────────────

    // Выгружать товары кассы: коды, названия, группы.
    // Нужно, чтобы связать блюда приложения с товарами iiko —
    // без этой связи заказ на кассу не уедет.
    "syncMenu": true,

    // Номенклатура меняется редко, гонять часто незачем.
    "menuIntervalMinutes": 360,

    // Версия формата выгрузки. Если меняем поля меню, поднимаем значение:
    // плагин отправит полный срез заново даже без изменений в iiko.
    "menuSchemaVersion": "mamaroma-menu-v2",

    // Выгружать ли снятые с продажи. Обычно не нужно.
    "menuIncludeInactive": false,

    // ── Статусы: касса → приложение ─────────────────────────────

    // Отдавать состояние заказов, заведённых через нас. Из этого
    // гость видит в приложении «принят», «готовим», «в пути».
    // Чужие заказы — с сайта, из колл-центра — не трогаем.
    "syncDeliveryStatus": true,

    // Как часто. Гость смотрит на экран заказа и ждёт движения.
    "deliveryStatusIntervalSeconds": 30,

    // За сколько часов назад смотреть заказы. Больше суток
    // держать незачем — заказ давно закрыт.
    "deliveryStatusLookbackHours": 12
  }
}
